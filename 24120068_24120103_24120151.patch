-def assert_equal(got, expect, msg=""):
-    if got == expect:
-        return
-    if msg:
-        msg += "\n"
-    raise AssertionError("%sgot:\n  %s\nexpected:\n  %s" %
-                         (msg, str(got).replace("\n", "\n  "),
-                          str(expect).replace("\n", "\n  ")))
