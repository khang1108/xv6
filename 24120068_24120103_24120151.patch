-        self.outbytes.extend(buf)
-        self.output = self.outbytes.decode("utf-8", "replace")
-        for callback in self.on_output:
-            callback(buf)
-        if buf == b"":
-            self.wait()
-            return
-
-    def write(self, buf):
-        if isinstance(buf, str):
-            buf = buf.encode('utf-8')
-        self.proc.stdin.write(buf)
-        self.proc.stdin.flush()
