-        maybe_unlink("obj/kern/init.o", "obj/kern/kernel")
-        if kw.pop("snapshot", True):
-            kw.setdefault("make_args", []).append("QEMUEXTRA+=-snapshot")
-        self.run_qemu(target_base="run-%s" % binary, *monitors, **kw)
