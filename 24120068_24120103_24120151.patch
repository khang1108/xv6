-    @staticmethod
-    def get_gdb_port():
-        if QEMU._GDBPORT is None:
-            p = Popen(["make", "-s", "--no-print-directory", "print-gdbport"],
-                      stdout=subprocess.PIPE)
-            (out, _) = p.communicate()
-            if p.returncode:
